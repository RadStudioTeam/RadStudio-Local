{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:radstudio:schema:project.json",
  "title": "Project",
  "description": "项目：数据集、工作流版本、实验运行与产物的最小管理单元",
  "type": "object",
  "required": ["id", "name", "status", "createdAt", "updatedAt", "createdBy"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "format": "uuid"
    }
  }
}
