{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blocks"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "groupId", "parts", "evidenceIds"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["fact", "explanation", "concept", "insufficient"]
          },
          "groupId": { "type": "string" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string" },
                "factId": { "type": "string" },
                "conceptKey": { "type": "string" }
              },
              "minProperties": 1,
              "maxProperties": 1
            }
          },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
