{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radstudio:schema:execution-contract-v1.json",
  "title": "Execution Contract v1",
  "$defs": {
    "parameterContract": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "dialect": {
          "const": "radstudio-parameters/1"
        },
        "operatorType": {
          "type": "string",
          "minLength": 1
        },
        "operatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifactPorts": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "contentContracts": {
              "const": 1
            },
            "inputs": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "contract": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 24
                          },
                          "task": {
                            "type": "string",
                            "maxLength": 80
                          },
                          "dimension": {
                            "enum": [
                              "",
                              "2d",
                              "3d",
                              "tabular"
                            ]
                          },
                          "modelFamily": {
                            "type": "string",
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "id",
                          "version"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cardinality": {
                    "enum": [
                      "",
                      "one",
                      "many"
                    ]
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "outputs": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "contract": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 24
                          },
                          "task": {
                            "type": "string",
                            "maxLength": 80
                          },
                          "dimension": {
                            "enum": [
                              "",
                              "2d",
                              "3d",
                              "tabular"
                            ]
                          },
                          "modelFamily": {
                            "type": "string",
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "id",
                          "version"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mergePart": {
                    "type": "object",
                    "properties": {
                      "artifact": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "port": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "artifact",
                      "port",
                      "file"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "version",
            "contentContracts",
            "inputs",
            "outputs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "dialect",
        "operatorType",
        "operatorVersion",
        "schema",
        "digest"
      ],
      "additionalProperties": false
    },
    "executionControls": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "checkpointEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "progressSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "shardIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "shardCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "mergeParts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "shardOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "foldIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "parameterDigest": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "invocationDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "parameterDigest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": 2
              }
            }
          },
          "then": {
            "required": [
              "invocationDigest"
            ],
            "properties": {
              "parameterDigest": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "invocationDigest"
              ]
            }
          }
        }
      ]
    },
    "invocationContract": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
