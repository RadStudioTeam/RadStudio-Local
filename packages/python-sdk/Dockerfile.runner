# 构建阶段：pyradiomics 需要从源码编译 C 扩展（PyPI sdist 损坏，只能源码装），
# 因此本阶段带编译工具链，运行阶段保持 slim。
FROM python:3.12-slim AS builder
# UV_DEFAULT_INDEX：GitHub/PyPI 直连不稳时传国内镜像（如 https://mirrors.aliyun.com/pypi/simple/）
ARG UV_DEFAULT_INDEX=""
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/runner
COPY packages/python-sdk/pyproject.toml packages/python-sdk/uv.lock ./
# pyradiomics 固定为 GitHub 源码包（PyPI sdist 损坏）；本仓不携带 vendor 二进制，
# 构建时从钉死 commit 拉取；网络受限可用 --build-arg PY_RADIOMICS_URL=<镜像地址> 覆盖。
ARG PY_RADIOMICS_URL="https://github.com/AIM-Harvard/pyradiomics/archive/8ed579383b44806651c463d5e691f3b2b57522ab.tar.gz"
RUN uv sync --frozen --no-dev --no-install-project --no-install-package pyradiomics --extra readers-sc \
    && uv pip install --python .venv/bin/python "$PY_RADIOMICS_URL" \
    && rm -rf ./vendor

FROM python:3.12-slim
WORKDIR /opt/runner
COPY --from=builder /opt/runner/.venv /opt/runner/.venv
COPY packages/python-sdk/radstudio ./radstudio
COPY packages/operator-schema/operators.json ./radstudio/operators.json
ENV PATH="/opt/runner/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
EXPOSE 8765
USER 65532:65532
ENTRYPOINT ["python", "-m", "radstudio.cli"]
