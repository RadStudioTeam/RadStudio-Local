# 深度学习算子镜像：基础算子镜像 + PyTorch（[dl] extra）。
# GPU 环境：--build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu124
# （默认 CPU 轮子；宿主机无 GPU 时算子内 torch 自动回退 CPU 并警告）。
# 入口与基础算子镜像一致（serve 模式 HTTP /invoke），约定见 Dockerfile.operator。
# 预训练骨干权重在构建期下载并烘焙进镜像（运行容器网络隔离，无法在线下载）。
FROM python:3.12-slim AS builder
# TORCH_INDEX：CUDA 构建传 https://download.pytorch.org/whl/cu124（默认 CPU 轮子）
# UV_DEFAULT_INDEX：GitHub/PyPI 直连不稳时传国内镜像（如 https://mirrors.aliyun.com/pypi/simple/）
ARG TORCH_INDEX=""
ARG UV_DEFAULT_INDEX=""
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
# UV_HTTP_TIMEOUT：只用于本轮 CUDA 下载（单个 nvidia 轮子可达 200MB，uv 默认
# 30s 会判超时使整层重来）。以 RUN 内联变量而非 ENV 传入，避免新增镜像层
# 作废前面 uv sync 的构建缓存。
ARG UV_HTTP_TIMEOUT="600"
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/runner
COPY packages/python-sdk/pyproject.toml packages/python-sdk/uv.lock ./
# pyradiomics 固定为 GitHub 源码包（PyPI sdist 损坏）；本仓不携带 vendor 二进制，
# 构建时从钉死 commit 拉取；网络受限可用 --build-arg PY_RADIOMICS_URL=<镜像地址> 覆盖。
RUN uv sync --frozen --no-dev --no-install-project --extra dl --no-install-package pyradiomics \
    && uv pip install --python .venv/bin/python "$PY_RADIOMICS_URL" \
    && rm -rf ./vendor
# CUDA 构建：从 TORCH_INDEX 覆盖安装 torch/torchvision（基础依赖按 lock 解析为 CPU 轮子）
RUN if [ -n "$TORCH_INDEX" ]; then \
        UV_HTTP_TIMEOUT="$UV_HTTP_TIMEOUT" uv pip install --python /opt/runner/.venv/bin/python \
            --index-url "$TORCH_INDEX" \
            --reinstall-package torch --reinstall-package torchvision \
            "torch>=2.2,<3" "torchvision>=0.17,<1"; \
    fi
# 预下载 ImageNet 预训练权重（torchvision resnet/efficientnet + MONAI DenseNet121）
# 到共享缓存；运行容器不联网时可复用。MONAI 权重同样落在 TORCH_HOME/hub/checkpoints。
ENV TORCH_HOME=/opt/torch_cache
# BuildKit heredoc：python -c 内含换行与缩进，不能写成普通 RUN 字符串
RUN <<'EOF'
.venv/bin/python -c "
from torchvision.models import resnet18, resnet34, resnet50, efficientnet_b0
from monai.networks.nets import DenseNet121
for build in (resnet18, resnet34, resnet50, efficientnet_b0):
    build(weights='IMAGENET1K_V1')
DenseNet121(spatial_dims=2, in_channels=3, out_channels=1, pretrained=True, progress=False)
print('pretrained weights cached')
"
EOF

FROM python:3.12-slim
# MONAI 导入时会调用 getpass.getuser()，非 root UID 必须有 passwd 条目
RUN echo 'nonroot:x:65532:65532:nonroot:/nonexistent:/sbin/nologin' >> /etc/passwd \
    && echo 'nonroot:x:65532:' >> /etc/group
WORKDIR /opt/runner
COPY --from=builder /opt/runner/.venv /opt/runner/.venv
COPY packages/python-sdk/radstudio ./radstudio
COPY --from=builder /opt/torch_cache /opt/torch_cache
ENV PATH="/opt/runner/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 TORCH_HOME=/opt/torch_cache
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["python", "-m", "radstudio.operator_serve", "--host", "0.0.0.0", "--port", "8080"]
