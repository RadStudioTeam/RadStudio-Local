# 算子云函数镜像：与 runner 同一构建基座，入口为 serve 模式（HTTP /invoke）。
# 部署到 Serverless 容器平台（阿里云 FC 容器模式 / 腾讯云 SCF 容器镜像 /
# Cloud Run 等）时的约定：
#   - 必须设置环境变量 RADSTUDIO_OPERATOR_TOKEN（Bearer 认证，未配置时拒绝执行）
#   - 监听 8080 端口（如平台要求其他端口，用容器启动参数 --port 覆盖）
#   - 平台需放通 HTTP POST /invoke 与 GET /healthz
# 构建与部署见 scripts/build-operator-image.* 与 scripts/deploy-operator.*。
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/runner
COPY packages/python-sdk/pyproject.toml packages/python-sdk/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim
WORKDIR /opt/runner
COPY --from=builder /opt/runner/.venv /opt/runner/.venv
COPY packages/python-sdk/radstudio ./radstudio
ENV PATH="/opt/runner/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["python", "-m", "radstudio.operator_serve", "--host", "0.0.0.0", "--port", "8080"]
