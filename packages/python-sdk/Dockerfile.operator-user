# 用户自定义算子统一运行时镜像（入口 radstudio.user_serve）。
#
# 与 Dockerfile.operator 的差异（这三条是「受控执行用户代码」的前提）：
#   - 常驻进程**不加载内置算子注册表**：用户 operatorType 只可能命中用户代码自己
#     注册的算子，杜绝「猜类型冒用内置实现」。用户代码本身也只在隔离子进程里导入。
#   - 依赖只来自镜像里预置的轮子（基础依赖 + [user] extra），运行期禁 pip；
#     用户按 allowPackages 声明，未声明或未预置的包以 user_dependency_blocked 拒绝。
#   - RADSTUDIO_USER_OPERATORS=1：只有本镜像被批准执行用户代码，内置算子镜像默认拒绝。
#
# 部署约定：
#   - RADSTUDIO_OPERATOR_TOKEN 由平台环境变量注入；未配置时 /invoke 直接 503，
#     镜像内不烘焙任何凭据（本文件 COPY 的内容全部来自仓库，不含密钥）。
#   - instanceConcurrency 必须为 1：一个实例只服务一个请求，跨用户不复用进程与临时目录。
#   - 监听 8080；工作区与解包目录走 tempfile（容器 /tmp 可写），OSS 只读挂载仅用于
#     工作流节点直读输入，用户代码拿不到对象存储写权限。
#
# 构建（仓库根目录，与 DL 镜像同一口径）：
#   docker build --provenance=false --platform linux/amd64 \
#     -f packages/python-sdk/Dockerfile.operator-user \
#     -t registry.example.com/radstudio/radstudio:operator-user-<TAG> .
FROM python:3.12-slim AS builder
# UV_DEFAULT_INDEX：GitHub/PyPI 直连不稳时传国内镜像（如 https://mirrors.aliyun.com/pypi/simple/）
ARG UV_DEFAULT_INDEX=""
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/runner
COPY packages/python-sdk/pyproject.toml packages/python-sdk/uv.lock ./
# pyradiomics 固定为 GitHub 源码包（PyPI sdist 损坏）；本仓不携带 vendor 二进制，
# 构建时从钉死 commit 拉取；网络受限可用 --build-arg PY_RADIOMICS_URL=<镜像地址> 覆盖。
RUN uv sync --frozen --no-dev --no-install-project --extra user --no-install-package pyradiomics \
    && uv pip install --python .venv/bin/python "$PY_RADIOMICS_URL" \
    && rm -rf ./vendor

FROM python:3.12-slim
# 隔离子进程继承本 UID；显式登记 passwd 条目，避免依赖 getpass 的库在非 root UID 下报错
RUN echo 'nonroot:x:65532:65532:nonroot:/nonexistent:/sbin/nologin' >> /etc/passwd \
    && echo 'nonroot:x:65532:' >> /etc/group
WORKDIR /opt/runner
COPY --from=builder /opt/runner/.venv /opt/runner/.venv
COPY packages/python-sdk/radstudio ./radstudio
ENV PATH="/opt/runner/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 RADSTUDIO_USER_OPERATORS=1
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["python", "-m", "radstudio.user_serve", "--host", "0.0.0.0", "--port", "8080"]
